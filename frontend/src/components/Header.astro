---
// Header.astro - Üst Bilgi Başlık Alanı
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<header class="content-header">
  <div class="header-title-wrapper">
    <h1 class="main-heading">{title}</h1>
    {subtitle && <p class="sub-heading">{subtitle}</p>}
  </div>
  
  <div class="header-actions-slot">
    <!-- Sayfaya özel üst eylemler buraya gelebilir -->
  </div>
</header>