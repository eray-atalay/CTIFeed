---
import Layout from '../layouts/Layout.astro';
import Metrics from '../components/Metrics.astro';
import Analytics from '../components/Analytics.astro';
import ThreatFeed from '../components/islands/ThreatFeed';
import ArticleModal from '../components/islands/ArticleModal';
---

<Layout title="CTIFeed Tehdit Radarı | Ana Akış">
  <div style="background: linear-gradient(135deg, rgba(14, 20, 34, 0.9) 0%, rgba(10, 15, 26, 0.95) 100%); border: 1px solid rgba(56, 189, 248, 0.15); border-radius: var(--radius-lg); padding: 24px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4); margin-bottom: 24px;">
    <h1 style="font-size: 1.5rem; font-weight: 700; color: #fff; margin: 0 0 6px 0; letter-spacing: -0.02em;">
      Tehdit İstihbarat Akışı
    </h1>
    <p style="font-size: 0.875rem; color: var(--text-secondary); margin: 0;">
      Gerçek zamanlı siber tehdit istihbaratı ve önceliklendirme motoru paneli.
    </p>
  </div>

  <Metrics />
  <Analytics />
  <ThreatFeed client:load />
  
  <ArticleModal client:load />
</Layout>