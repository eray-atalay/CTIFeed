# Telegram Bot API Token (Optional: enables Telegram notifications and interactive bot)
TELEGRAM_BOT_TOKEN=

# Web Dashboard Port
PORT=8080

# SQLite Database Path
DB_PATH=ctifeed.db

# Feed Polling Interval (e.g. 15m, 1h)
INTERVAL=15m

# Worker pool size for concurrent feed requests
WORKERS=5

# Timeout per feed request
TIMEOUT=10s

# Maximum article age to process (e.g. 48h, 168h)
MAX_AGE=168h
