# Telegram Bot API Token (Optional: enables Telegram notifications and interactive bot)
TELEGRAM_BOT_TOKEN=

# Web Dashboard Port
PORT=8080

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ctifeed
DB_PASSWORD=ctifeed_secret
DB_NAME=ctifeed
# Alternatively provide full DSN:
# MYSQL_DSN=ctifeed:ctifeed_secret@tcp(127.0.0.1:3306)/ctifeed?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci&loc=UTC

# Feed Polling Interval (e.g. 15m, 1h)
INTERVAL=15m

# Worker pool size for concurrent feed requests
WORKERS=5

# Timeout per feed request
TIMEOUT=10s

# Maximum article age to process (e.g. 48h, 168h)
MAX_AGE=168h
