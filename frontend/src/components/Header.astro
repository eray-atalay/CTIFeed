---
// Header.astro - CTIFeed Tehdit Radarı Üst Bilgi Bileşeni (Sıfır Emoji)
---

<header class="app-header">
  <div class="header-container">
    <div class="brand-group">
      <div class="radar-pulse-icon">
        <div class="pulse-ring"></div>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 3v9l6 6"></path>
          <circle cx="12" cy="12" r="3" fill="currentColor"></circle>
        </svg>
      </div>
      <div class="brand-text">
        <h1>CTIFeed <span class="badge-radar">Tehdit Radarı</span></h1>
        <p class="brand-sub">Gerçek Zamanlı Siber Tehdit İstihbaratı ve Önceliklendirme Motoru</p>
      </div>
    </div>

    <div class="header-actions">
      <!-- Telegram Bot Yönlendirme Butonu -->
      <a href="https://t.me/ctifeed_radar_bot" target="_blank" rel="noopener noreferrer" class="btn-secondary btn-telegram" title="Telegram Bildirim Botunu Aç">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
          <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.562 8.161c-.18.892-.966 4.503-1.364 6.353-.168.783-.497 1.045-.818 1.07-.697.054-1.226-.45-1.9-.891-1.056-.692-1.653-1.123-2.678-1.799-1.185-.781-.417-1.21.258-1.911.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.831-2.529 7.001-3.014 3.332-1.386 4.025-1.627 4.476-1.635.099-.002.321.023.465.14.121.099.155.232.171.326.016.094.037.309.021.477z"/>
        </svg>
        <span>Telegram Botu</span>
      </a>

      <!-- IoC Havuzu Butonu -->
      <button id="btn-iocs" class="btn-secondary" title="Tehdit Göstergelerini (IoC) İncele ve İndir">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 3v3M12 18v3M3 12h3M18 12h3"></path>
          <circle cx="12" cy="12" r="2"></circle>
        </svg>
        <span>IoC Havuzu</span>
      </button>

      <button id="btn-sources" class="btn-secondary" title="İzlenen CTI Besleme Kaynaklarını Görüntüle">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h7"></path>
        </svg>
        <span>Kaynaklar (<span id="sources-count-badge">22</span>)</span>
      </button>

      <button id="btn-scan-now" class="btn-primary" title="Tüm CTI beslemelerini anında tara">
        <svg class="scan-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
        </svg>
        <span id="scan-btn-text">Beslemeleri Tara</span>
      </button>
    </div>
  </div>
</header>
