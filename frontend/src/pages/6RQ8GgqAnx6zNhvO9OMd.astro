---
import Layout from '../layouts/Layout.astro';
---

<Layout title="CTIFeed | Admin Paneli">
  <div class="page-header-row">
    <h1 class="page-title">Admin Paneli</h1>
    <p class="page-desc">Yönetim operasyonları için güvenli giriş. Bu panelde yalnızca admin erişimi vardır.</p>
  </div>

  <div class="admin-panel-shell">
    <div id="admin-login-view" class="admin-card">
      <div class="admin-card-header">
        <span class="admin-badge">Güvenli Giriş</span>
        <h2>Admin Girişi</h2>
      </div>

      <form id="admin-login-form" class="admin-form">
        <label>
          <span>Kullanıcı Adı</span>
          <input id="admin-user" type="text" name="username" autocomplete="username" required />
        </label>

        <label>
          <span>Şifre</span>
          <input id="admin-password" type="password" name="password" autocomplete="current-password" required />
        </label>

        <button type="submit" class="btn-primary admin-submit">Giriş Yap</button>
      </form>

      <p id="admin-login-error" class="admin-error" aria-live="polite"></p>
    </div>

    <div id="admin-dashboard-view" class="admin-card" style="display:none;">
      <div class="admin-card-header">
        <span class="admin-badge success">Yönetici</span>
        <h2>Kontrol Merkezi</h2>
      </div>

      <div class="admin-grid">
        <div class="admin-stat">
          <span class="admin-stat-label">Tarama</span>
          <strong>Manuel besleme taraması</strong>
        </div>
        <div class="admin-stat">
          <span class="admin-stat-label">Kaynak Yönetimi</span>
          <strong>RSS / X kaynak ekleme ve devre dışı bırakma</strong>
        </div>
      </div>

      <div class="admin-actions">
        <button id="admin-scan-btn" class="btn-primary" type="button">Beslemeleri Tara</button>
        <a href="/sources" class="btn-secondary admin-link">Kaynaklar Sayfası</a>
        <button id="admin-logout-btn" class="btn-secondary" type="button">Çıkış Yap</button>
      </div>

      <p id="admin-status-message" class="admin-status" aria-live="polite"></p>
    </div>
  </div>
</Layout>

<script>
  import { verifyAdminCredentials, isAdminLoggedIn, clearAdminSession, triggerScan } from '../services/api';

  const loginView = document.getElementById('admin-login-view');
  const dashboardView = document.getElementById('admin-dashboard-view');
  const loginForm = document.getElementById('admin-login-form');
  const errorBox = document.getElementById('admin-login-error');
  const statusBox = document.getElementById('admin-status-message');
  const scanBtn = document.getElementById('admin-scan-btn');
  const logoutBtn = document.getElementById('admin-logout-btn');

  function setView(isLoggedIn) {
    if (loginView) loginView.style.display = isLoggedIn ? 'none' : 'block';
    if (dashboardView) dashboardView.style.display = isLoggedIn ? 'block' : 'none';
  }

  function showError(message) {
    if (!errorBox) return;
    errorBox.textContent = message;
  }

  function showStatus(message) {
    if (!statusBox) return;
    statusBox.textContent = message;
  }

  async function handleLogin(event) {
    event.preventDefault();
    const username = document.getElementById('admin-user')?.value?.trim();
    const password = document.getElementById('admin-password')?.value ?? '';

    if (!username || !password) {
      showError('Kullanıcı adı ve şifre gerekli.');
      return;
    }

    try {
      const isValid = await verifyAdminCredentials(username, password);
      if (!isValid) {
        showError('Geçersiz admin kimlik bilgileri.');
        return;
      }

      showError('');
      setView(true);
      showStatus('Yönetici olarak giriş yapıldı.');
    } catch (err) {
      showError(err instanceof Error ? err.message : 'Giriş sırasında hata oluştu.');
    }
  }

  async function handleManualScan() {
    try {
      const result = await triggerScan();
      const newInserted = Number(result.new_inserted ?? 0);
      const skipped = Number(result.duplicates_skipped ?? 0);
      showStatus(`Tamamlandı: ${newInserted} yeni, ${skipped} atlandı.`);
    } catch (err) {
      const message = err instanceof Error ? err.message : 'Tarama başarısız oldu';
      showStatus(message);
    }
  }

  if (loginForm) {
    loginForm.addEventListener('submit', handleLogin);
  }

  if (scanBtn) {
    scanBtn.addEventListener('click', handleManualScan);
  }

  if (logoutBtn) {
    logoutBtn.addEventListener('click', () => {
      clearAdminSession();
      showStatus('');
      setView(false);
      if (document.getElementById('admin-user')) document.getElementById('admin-user').value = '';
      if (document.getElementById('admin-password')) document.getElementById('admin-password').value = '';
    });
  }

  isAdminLoggedIn().then(setView);
</script>

<style>
  .admin-panel-shell {
    display: grid;
    gap: 20px;
    margin-top: 20px;
  }

  .admin-card {
    background: rgba(11, 18, 32, 0.86);
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 18px;
    padding: 24px;
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.28);
  }

  .admin-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }

  .admin-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 6px 10px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: rgba(59, 130, 246, 0.14);
    color: #7dd3fc;
    border: 1px solid rgba(125, 211, 252, 0.35);
  }

  .admin-badge.success {
    background: rgba(34, 197, 94, 0.12);
    color: #86efac;
    border-color: rgba(134, 239, 172, 0.32);
  }

  .admin-card h2 {
    margin: 0;
    color: var(--text-primary);
    font-size: 1.35rem;
  }

  .admin-form {
    display: grid;
    gap: 18px;
  }

  .admin-form label {
    display: grid;
    gap: 8px;
  }

  .admin-form span {
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .admin-form input {
    background: rgba(15, 23, 42, 0.9);
    border: 1px solid rgba(148, 163, 184, 0.26);
    border-radius: 10px;
    color: var(--text-base);
    font-size: 0.95rem;
    padding: 11px 12px;
  }

  .admin-submit {
    width: 100%;
    justify-content: center;
  }

  .admin-error,
  .admin-status {
    min-height: 20px;
    margin-top: 14px;
    font-size: 0.82rem;
    color: #fca5a5;
  }

  .admin-status {
    color: #86efac;
  }

  .admin-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-bottom: 18px;
  }

  .admin-stat {
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 12px;
    padding: 16px;
    display: grid;
    gap: 8px;
  }

  .admin-stat-label {
    color: var(--text-muted);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .admin-stat strong {
    color: var(--text-primary);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .admin-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }

  .admin-link {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
</style>
