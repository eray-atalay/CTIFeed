# Telegram Bot API Token (Optional: enables Telegram notifications and interactive bot)
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token

# Web Dashboard Port
PORT=8080

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ctifeed
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-this-root-password
DB_NAME=ctifeed
# Alternatively provide full DSN:
# MYSQL_DSN=user:password@tcp(127.0.0.1:3306)/database?parseTime=true

# Admin authentication
CTIFEED_ADMIN_USERNAME=admin
CTIFEED_ADMIN_PASSWORD=change-this-password
CTIFEED_ADMIN_JWT_SECRET=generate-a-long-random-secret

# Feed Polling Interval (e.g. 15m, 1h)
INTERVAL=15m

# Worker pool size for concurrent feed requests
WORKERS=5

# Timeout per feed request
TIMEOUT=10s

# Maximum article age to process (e.g. 48h, 168h)
MAX_AGE=168h
