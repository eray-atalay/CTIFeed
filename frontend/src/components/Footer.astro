---
// frontend/src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="app-footer">
  <div class="footer-container">
    <div class="footer-brand-section">
      <a href="https://yildizcti.com.tr" target="_blank" rel="noopener noreferrer" class="footer-logo-row" title="Yıldız CTI">
        <div class="footer-logo-box">
          <img src="/logo.png" alt="Yıldız CTI Logo" class="footer-logo-img" />
        </div>
        <span class="footer-brand-name">Yıldız CTI</span>
      </a>
    </div>

    <nav class="footer-nav-centered" aria-label="Alt Navigasyon">
      <a href="/">Ana Akış & Paneller</a>
      <span class="footer-nav-dot">•</span>
      <a href="/radars/cve">CVE Zafiyet Radarı</a>
      <span class="footer-nav-dot">•</span>
      <a href="/radars/breach">Veri Sızıntısı Radarı</a>
      <span class="footer-nav-dot">•</span>
      <a href="/ioc-pool">IoC Tehdit Havuzu</a>
      <span class="footer-nav-dot">•</span>
      <a href="/sources">İzlenen Kaynaklar</a>
      <span class="footer-nav-dot">•</span>
      <a href="https://yildizcti.com.tr" target="_blank" rel="noopener noreferrer" class="footer-domain-inline-link">
        Yıldız CTI ↗
      </a>
    </nav>
  </div>

  <div class="footer-bottom-bar">
    <div class="footer-bottom-content">
      <p class="footer-copy">
        &copy; {currentYear} <a href="https://yildizcti.com.tr" target="_blank" rel="noopener noreferrer" class="footer-copy-link"><strong>Yıldız CTI</strong></a>. Tüm hakları saklıdır.
      </p>
    </div>
  </div>
</footer>
