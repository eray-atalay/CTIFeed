---
// Header.astro - CTIFeed Tehdit Radarı Üst Bilgi Bileşeni (Sıfır Emoji)
---

<header class="app-header">
  <div class="header-container">
    <div class="brand-group">
      <div class="radar-pulse-icon">
        <div class="pulse-ring"></div>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 3v9l6 6"></path>
          <circle cx="12" cy="12" r="3" fill="currentColor"></circle>
        </svg>
      </div>
      <div class="brand-text">
        <h1>CTIFeed <span class="badge-radar">Tehdit Radarı</span></h1>
        <p class="brand-sub">Gerçek Zamanlı Siber Tehdit İstihbaratı ve Önceliklendirme Motoru</p>
      </div>
    </div>

    <div class="header-actions">
      <button id="btn-sources" class="btn-secondary" title="İzlenen CTI Besleme Kaynaklarını Görüntüle">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h7"></path>
        </svg>
        <span>Kaynaklar (<span id="sources-count-badge">18</span>)</span>
      </button>

      <button id="btn-scan-now" class="btn-primary" title="Tüm CTI beslemelerini anında tara">
        <svg class="scan-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
        </svg>
        <span id="scan-btn-text">Beslemeleri Tara</span>
      </button>
    </div>
  </div>
</header>
