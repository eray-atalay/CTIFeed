---
// frontend/src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="app-footer">
  <div class="footer-container">
    <div class="footer-brand-section">
      <div class="footer-logo-row">
        <div class="footer-logo-box">
          <img src="/logo.png" alt="Yıldız CTI Logo" class="footer-logo-img" />
        </div>
        <div class="footer-brand-text">
          <span class="footer-brand-name">Yıldız CTI</span>
          <span class="footer-brand-desc">Siber Tehdit İstihbaratı ve Önceliklendirme Radarı</span>
        </div>
      </div>
      <p class="footer-subtext">
        Kritik altyapılar, ulusal ve küresel tehdit vektörleri için anlık CTI toplayıcı ve kural tabanlı dinamik önceliklendirme platformu.
      </p>
    </div>

    <div class="footer-links-group">
      <div class="footer-col">
        <span class="footer-heading">Navigasyon</span>
        <ul class="footer-nav-list">
          <li><a href="/">Ana Akış & Paneller</a></li>
          <li><a href="/radars/cve">CVE Zafiyet Radarı</a></li>
          <li><a href="/radars/breach">Veri Sızıntısı Radarı</a></li>
          <li><a href="/ioc-pool">IoC Tehdit Havuzu</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <span class="footer-heading">Kurumsal & Kaynaklar</span>
        <ul class="footer-nav-list">
          <li>
            <a href="https://yildizcti.com.tr" target="_blank" rel="noopener noreferrer" class="footer-domain-btn" title="Yıldız CTI Ana Sayfasına Git">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
              <span>yildizcti.com.tr</span>
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" class="external-icon">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          </li>
          <li><a href="/sources">İzlenen Besleme Kaynakları</a></li>
          <li>
            <a href="https://t.me/ctifeed_radar_bot" target="_blank" rel="noopener noreferrer">
              Telegram Bildirim Botu ↗
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-bottom-bar">
    <div class="footer-bottom-content">
      <div class="footer-domain-badge">
        <span class="domain-pulse-dot"></span>
        <a href="https://yildizcti.com.tr" target="_blank" rel="noopener noreferrer" class="footer-domain-text-link">
          yildizcti.com.tr
        </a>
      </div>
      <p class="footer-copy">
        &copy; {currentYear} <strong>Yıldız CTI</strong>. Tüm hakları saklıdır.
      </p>
      <div class="footer-system-status">
        <span class="status-indicator-dot"></span>
        <span>Sistem Aktif & Canlı Takipte</span>
      </div>
    </div>
  </div>
</footer>
