---
const currentPath = Astro.url.pathname;
---
<aside class="sidebar" id="app-sidebar">
  <div class="sidebar-brand">
    <div class="brand-info">
      <img src="/logo.png" alt="CTIFeed" class="brand-logo" width="36" height="36" />
      <div class="brand-title">
        <h2>CTIFeed</h2>
        <span>Tehdit Radarı</span>
      </div>
    </div>
  </div>

  <nav class="sidebar-nav">
    <a href="/" class={`nav-item ${currentPath === '/' ? 'active' : ''}`} title="Ana Akış">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
      <span>Ana Akış</span>
    </a>

    <a href="/radars/cve" class={`nav-item ${currentPath.includes('/radars/cve') ? 'active' : ''}`} title="CVE Zafiyet Radarı">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
      <span>CVE Zafiyet Radarı</span>
    </a>

    <a href="/radars/breach" class={`nav-item ${currentPath.includes('/radars/breach') ? 'active' : ''}`} title="Data Leak Radarı">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
      <span>Data Leak Radarı</span>
    </a>

    <a href="/ioc-pool" class={`nav-item ${currentPath.includes('/ioc-pool') ? 'active' : ''}`} title="IoC Havuzu">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="22" y1="12" x2="18" y2="12"></line><line x1="6" y1="12" x2="2" y2="12"></line><line x1="12" y1="6" x2="12" y2="2"></line><line x1="12" y1="22" x2="12" y2="18"></line></svg>
      <span>IoC Havuzu</span>
    </a>

    <a href="/sources" class={`nav-item ${currentPath.includes('/sources') ? 'active' : ''}`} title="Kaynaklar">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
      <span>Kaynaklar</span>
    </a>

    <div class="nav-scan-divider"></div>
    <button id="sidebar-scan-btn" class="nav-scan-btn" title="Tüm aktif besleme kaynaklarını şimdi tara">
      <svg id="sidebar-scan-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="23 4 23 10 17 10"></polyline>
        <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
      </svg>
      <span id="sidebar-scan-label">Besleme Tara</span>
    </button>
    <div id="sidebar-scan-status" class="nav-scan-status" style="display:none"></div>
  </nav>

  <button id="sidebar-toggle-btn" class="sidebar-toggle-btn" title="Menüyü Daralt / Genişlet" aria-label="Menüyü Daralt / Genişlet">
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </button>
</aside>

<script>
  import { triggerScan, isAdminLoggedIn } from '../services/api';
  import { triggerGlobalRefresh } from '../services/store';

  const sidebar = document.getElementById('app-sidebar');
  const toggleBtn = document.getElementById('sidebar-toggle-btn');
  const btn = document.getElementById('sidebar-scan-btn');
  const label = document.getElementById('sidebar-scan-label');
  const status = document.getElementById('sidebar-scan-status');

  if (localStorage.getItem('sidebar_collapsed') === 'true') {
    sidebar?.classList.add('collapsed');
  }

  toggleBtn?.addEventListener('click', () => {
    sidebar?.classList.toggle('collapsed');
    const isCollapsed = sidebar?.classList.contains('collapsed');
    localStorage.setItem('sidebar_collapsed', isCollapsed ? 'true' : 'false');
  });

  isAdminLoggedIn().then((adminVisible) => {
    if (btn) btn.style.display = adminVisible ? 'flex' : 'none';
    if (!adminVisible && status) status.style.display = 'none';
    if (!btn || !adminVisible) return;

    btn.addEventListener('click', async () => {
      if (btn.disabled) return;

      btn.disabled = true;
      btn.classList.add('scanning');
      if (label) label.textContent = 'Taranıyor...';
      if (status) status.style.display = 'none';

      try {
        const result = await triggerScan();
        const newInserted = Number(result.new_inserted ?? 0);
        const duplicatesSkipped = Number(result.duplicates_skipped ?? 0);

        showStatus(`✓ ${newInserted} yeni, ${duplicatesSkipped} atlandı`, 'ok');
        triggerGlobalRefresh();
      } catch (err) {
        const message = err instanceof Error ? err.message : 'Tarama başarısız oldu';
        const displayMessage = message.includes('409') || message.toLowerCase().includes('already')
          ? '⚠ Zaten devam eden bir tarama var.'
          : '✗ Tarama başarısız oldu';
        showStatus(displayMessage, 'warn');
      } finally {
        btn.disabled = false;
        btn.classList.remove('scanning');
        if (label) label.textContent = 'Besleme Tara';
      }
    });
  });

  function showStatus(msg: string, type: string) {
    if (!status) return;
    status.textContent = msg;
    status.className = 'nav-scan-status nav-scan-status--' + type;
    status.style.display = 'block';
    setTimeout(() => {
      status.style.display = 'none';
    }, 5000);
  }
</script>